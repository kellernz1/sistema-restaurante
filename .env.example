NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Legacy fallbacks are still accepted during migration:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
APP_MODE=production

# Local-only values are generated by `npm run local:env`.
LOCAL_LAN_IP=
PUBLIC_TEST_URL=http://localhost:3000
DEMO_PASSWORD=

# WhatsApp Business Cloud API (used in Phase 10)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_MOCK=false

# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
# Otherwise the rate limiter safely uses a shared network bucket.
PUBLIC_TRUST_PROXY=false

# Choose a supported Graph API version from the Meta app dashboard, e.g. vNN.0.
WHATSAPP_API_VERSION=
# Random server-only secret for the scheduled worker and development simulator.
WHATSAPP_WORKER_SECRET=

# Owner-issued Ed25519 public key (64 hex characters). NEVER put a private key here.
LICENSE_PUBLIC_KEY=
